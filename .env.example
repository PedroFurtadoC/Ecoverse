# Copie este arquivo para `.env.local` e preencha as variáveis.
# `.env.local` está no .gitignore: nunca commite chaves reais.

# Supabase: Auth e leaderboard (opcional; o jogo roda sem isso usando localStorage)
# Pegue no painel do projeto Supabase em Project Settings > API Keys.
# Em VITE_SUPABASE_ANON_KEY vai a publishable key (sb_publishable_...), apesar do nome.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CRON_SECRET só existe na Vercel (protege /api/keep-alive). Não precisa no local.
