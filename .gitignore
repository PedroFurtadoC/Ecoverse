node_modules/
dist/
dist-ssr/
*.local

# Variáveis de ambiente: nunca commitar segredos
.env
.env.local
.env.*.local

# Arquivos temporários que o Word cria ao abrir um .docx
~$*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
